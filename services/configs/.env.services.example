# ==============================================================================
# Custom Harness AI Microservices Environment Configuration
# ==============================================================================

# 1. Gemma / Main LLM Configuration (vLLM)
GEMMA_MODEL_PATH=/mnt/nvmes/nvme2/llms/huggingface/hub/Huihui-gemma-4-26B-A4B-it-abliterated
GEMMA_PORT=8004
GEMMA_MAX_MODEL_LEN=16384
GEMMA_DTYPE=bfloat16
GEMMA_GPU_MEM=0.65
GEMMA_MAX_BATCHED_TOKENS=4096
GEMMA_MAX_SEQS=8
GEMMA_CUDA_DEVICES=0,1,2,3

# 2. Embedding Service Configuration (vLLM)
EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_PORT=8001
EMBEDDING_GPU_MEM=0.08
EMBEDDING_MAX_MODEL_LEN=4096
EMBEDDING_CUDA_DEVICES=3

# 3. Reranker Service Configuration
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_PORT=8006
RERANKER_DEVICE=cuda
RERANKER_MAX_LENGTH=8192
RERANKER_CUDA_DEVICES=1

# 4. SigLIP 2 Image Search Configuration
SIGLIP_MODEL_NAME=google/siglip2-base-patch16-224
SIGLIP_PORT=8011
SIGLIP_CUDA_DEVICES=0
POSTGRES_HOST=ecp-postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecp_db
POSTGRES_USER=ecp_user
POSTGRES_PASSWORD=ecp_pass

# 5. Document & GLM-OCR Configuration
OCR_MODEL_ID=zai-org/GLM-OCR
OCR_PORT=8010
OCR_CUDA_DEVICES=2
OCR_DEVICE=cuda:0
OCR_MAX_NEW_TOKENS=8192
OCR_TORCH_DTYPE=bfloat16

# 6. Global HuggingFace & Storage Paths
HF_CACHE_DIR=~/.cache/huggingface
NVME_DIR=/mnt/nvmes
HF_TOKEN=
