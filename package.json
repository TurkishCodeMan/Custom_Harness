{
  "name": "@custom-harness/root",
  "version": "0.1.0",
  "description": "Clean, modular Cordis-powered AI Agent Framework with Monorepo Architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @custom-harness/web dev",
    "start": "pnpm --filter @custom-harness/cli start",
    "web": "pnpm --filter @custom-harness/web dev",
    "cli": "pnpm --filter @custom-harness/cli dev",
    "rag:db": "docker compose -f docker-compose.rag.yml up -d",
    "rag:db:stop": "docker compose -f docker-compose.rag.yml down",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
