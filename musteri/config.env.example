# ==============================================================================
# Custom Harness CLI — Yapılandırma Dosyası
# ==============================================================================
# Bu dosyayı kendi LLM sunucu bilgilerinizle doldurun.
# Ardından ~/.config/dsh/config.env konumuna kopyalayın:
#   mkdir -p ~/.config/dsh
#   cp config.env.example ~/.config/dsh/config.env
#   nano ~/.config/dsh/config.env
# ==============================================================================


# ── LLM Sağlayıcı Seçimi ─────────────────────────────────────────────────────
# Şirket içi (on-prem) vLLM veya llama.cpp sunucusu için:
OPENAI_BASE_URL=http://192.168.1.100:8004/v1
OPENAI_API_KEY=dahili-api-anahtariniz
DEFAULT_MODEL=qwen3.8-27b-uncensored
DEFAULT_PROVIDER_NAME=Şirket İçi LLM (vLLM)

# Bulut API için (yorumu kaldırın):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-...
# DEFAULT_MODEL=gpt-4o
# DEFAULT_PROVIDER_NAME=OpenAI Cloud


# ── Agent Davranış Ayarları ───────────────────────────────────────────────────
# Context window (model'e göre ayarlayın): 8192, 16384, 32768
LLM_CONTEXT_WINDOW=16384

# Maksimum üretilecek token sayısı
LLM_MAX_TOKENS=8192

# YOLO modu: true = tüm bash komutlarını onay sormadan çalıştır (dikkatli kullanın)
AGENT_YOLO_MODE=false


# ── Çalışma Alanı ─────────────────────────────────────────────────────────────
# Container içinde projenizin bağlanacağı yol (değiştirmeyin)
WORKSPACE_DIR=/workspace

# Oturum geçmişi ve hafıza klasörü (container ile host arasında senkronize)
DSH_DIR=/root/.dsh
